+/// The WASI session log writes through one inode. A private hard link grants
+/// that inode without exposing any other file in the original directory.
+fn stage_session_store(source: &std::path::Path) -> Result<tempfile::TempDir> {
+    let source = if source.is_absolute() {
+        source.to_path_buf()
+    } else {
+        std::env::current_dir()?.join(source)
+    };
+    let parent = source.parent().ok_or_else(|| wasmtime::Error::msg("missing store parent"))?;
+    fs::create_dir_all(parent)?;
+    let mut options = fs::OpenOptions::new();
+    options.create(true).append(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600).custom_flags(libc::O_NOFOLLOW);
+    }
+    let file = options.open(&source)
+        .with_context(|| format!("opening session store {}", source.display()))?;
+    wasmtime::ensure!(file.metadata()?.is_file(), "session store must be a regular file");
+    let mount = private_mount(".tina-wasm-store-").tempdir_in(parent)?;
+    let link = mount.path().join("sessions.jsonl");
+    fs::hard_link(&source, &link)
+        .with_context(|| format!("isolating session store {}", source.display()))?;
+    wasmtime::ensure!(fs::symlink_metadata(link)?.is_file(), "session store must be a regular file");
     Ok(mount)
 }

+fn private_mount(prefix: &'static str) -> tempfile::Builder<'static, 'static> {
+    let mut builder = tempfile::Builder::new();
+    builder.prefix(prefix);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        builder.permissions(fs::Permissions::from_mode(0o700));
+    }
+    builder
+}
